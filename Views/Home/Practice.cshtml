@model VbeSort.Models.PracticeQueueViewModel
@{
    ViewData["Title"] = "Kartojimas";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 pb-3 border-bottom">
    <h1 class="h3 fw-bold mb-0">Kartojimas</h1>

    <div class="btn-group btn-group-sm" role="group" aria-label="Užduočių filtras pagal būseną">
        <a asp-action="Practice" asp-route-mode="due"
           class="btn @(Model.Mode == "due" ? "btn-primary" : "btn-outline-secondary")">
            Atidėtos pakartoti (@Model.DueCount)
        </a>
        <a asp-action="Practice" asp-route-mode="unseen"
           class="btn @(Model.Mode == "unseen" ? "btn-primary" : "btn-outline-secondary")">
            Nespręstos (@Model.UnseenCount)
        </a>
        <a asp-action="Practice" asp-route-mode="solved"
           class="btn @(Model.Mode == "solved" ? "btn-primary" : "btn-outline-secondary")">
            Išspręstos (@Model.SolvedCount)
        </a>
    </div>
</div>

@if (Model.Queue.Any())
{
    @foreach (var item in Model.Queue)
    {
        @await Html.PartialAsync("_ExerciseCardPartial", (item.Exercise, item.Progress, (string?)null))
    }
}
else
{
    <div class="vbe-card p-4 text-center">
        @if (Model.Mode == "due")
        {
            <h2 class="h6 fw-bold mb-2">Neturite pakartojimui atidėtų užduočių</h2>
            <p class="small text-muted mb-3">Spręsdami užduotis paspauskite „Pakartoti vėliau“, kad jos atsirastų šiame sąraše.</p>
        }
        else if (Model.Mode == "solved")
        {
            <h2 class="h6 fw-bold mb-2">Dar nepažymėjote nė vienos išspręstos užduoties</h2>
        }
        else
        {
            <h2 class="h6 fw-bold mb-2">Visos užduotys jau peržiūrėtos</h2>
        }
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">Eiti į temas</a>
    </div>
}
