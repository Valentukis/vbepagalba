@model List<VbeSort.Models.Topic>
@{
    ViewData["Title"] = "Statistika";
    var total = Model.Sum(t => t.Exercises.Count);
    var years = Model.SelectMany(t => t.Exercises).Select(e => e.Year).Distinct().OrderBy(y => y).ToList();
}

<div class="mb-3">
    <h3>Sistemos statistika</h3>
    <p class="text-muted small">Apibendrinti duomenys apie VBE užduotis sistemoje.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-center shadow-sm p-3 border-primary">
            <h2 class="text-primary fw-bold mb-0">@Model.Count</h2>
            <small class="text-muted">Temų skaičius</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center shadow-sm p-3 border-success">
            <h2 class="text-success fw-bold mb-0">@total</h2>
            <small class="text-muted">Užduočių skaičius</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center shadow-sm p-3 border-info">
            <h2 class="text-info fw-bold mb-0">@(years.FirstOrDefault() ?? "—")–@(years.LastOrDefault() ?? "—")</h2>
            <small class="text-muted">Metų aprėptis</small>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-dark text-white py-2"><h6 class="mb-0">Užduotys pagal temas</h6></div>
    <table class="table table-hover align-middle mb-0 small">
        <thead class="table-light"><tr><th>Tema</th><th class="text-center">Užduotys</th><th class="w-50">Dalis</th><th class="text-end">Veiksmas</th></tr></thead>
        <tbody>
            @foreach (var t in Model.OrderByDescending(x => x.Exercises.Count))
            {
                var p = total > 0 ? (int)Math.Round((double)t.Exercises.Count / total * 100) : 0;
                <tr>
                    <td><strong>@t.Name</strong></td>
                    <td class="text-center"><span class="badge bg-secondary">@t.Exercises.Count</span></td>
                    <td>
                        <div class="progress" style="height: 14px;">
                            <div class="progress-bar" style="width: @p%;">@p%</div>
                        </div>
                    </td>
                    <td class="text-end"><a asp-action="Topic" asp-route-name="@t.Name" class="btn btn-sm btn-outline-primary py-0">Atidaryti</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>