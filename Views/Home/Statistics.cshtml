@model VbeSort.Models.StatisticsPageViewModel
@{
    ViewData["Title"] = "Statistika";
    var total = Model.TotalExercises;
    var years = Model.ExercisesByYear.Keys.OrderBy(y => y).ToList();
}

<div class="mb-4 pb-3 border-bottom">
    <h1 class="h3 fw-bold mb-0">Statistika</h1>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="vbe-card text-center p-3">
            <div class="h3 fw-bold mb-0">@Model.Topics.Count</div>
            <div class="small text-muted">Temų skaičius</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="vbe-card text-center p-3">
            <div class="h3 fw-bold mb-0">@Model.TotalExercises</div>
            <div class="small text-muted">Užduočių skaičius</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="vbe-card text-center p-3">
            <div class="h3 fw-bold mb-0">@(years.FirstOrDefault() ?? "—")–@(years.LastOrDefault() ?? "—")</div>
            <div class="small text-muted">Metai</div>
        </div>
    </div>
</div>

<div class="vbe-card overflow-hidden">
    <div class="p-3 border-bottom">
        <h2 class="h6 fw-bold mb-0">Užduotys pagal temas</h2>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th>Tema</th>
                    <th class="text-center">Užduotys</th>
                    <th class="w-50">Dalis</th>
                    <th class="text-end">Veiksmas</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Topics.OrderByDescending(x => x.Exercises.Count))
                {
                    var p = total > 0 ? (int)Math.Round((double)t.Exercises.Count / total * 100) : 0;
                    <tr>
                        <td class="fw-semibold">@t.Name</td>
                        <td class="text-center">@t.Exercises.Count</td>
                        <td>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar" style="width: @Math.Max(2, p)%;"></div>
                            </div>
                        </td>
                        <td class="text-end">
                            <a asp-action="Topic" asp-route-name="@t.Name" class="btn btn-sm btn-outline-primary py-0">Atidaryti</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
