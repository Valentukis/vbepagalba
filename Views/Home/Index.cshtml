@model List<VbeSort.Models.Topic>
@{
    ViewData["Title"] = "Temos";
}

<div class="text-center">
    <h1 class="display-4">VBE Rūšiuoklė</h1>
    <p class="lead">Pasirinkite temą praktikuotis praėjusių VBE egzaminų užduotis.</p>
</div>

<div class="row mt-4">
    @if(Model != null && Model.Any())
    {
        @foreach (var topic in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@topic.Name</h5>
                        <p class="card-text text-muted">@topic.Exercises.Count užduočių</p>
                        <a asp-action="Topic" asp-route-name="@topic.Name" class="btn btn-primary mt-auto">Praktikuotis</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning w-100">
            Nerasta jokių temų. Įsitikinkite, kad 'surusiuotos' ir 'Atsakymai' aplankai yra teisingoje vietoje.
        </div>
    }
</div>
