@model VbeSort.Models.TopicPageViewModel
@{
    var topic = Model.Topic;
    ViewData["Title"] = topic.Name;
    var years = topic.Exercises.Select(e => e.Year).Distinct().OrderByDescending(y => y).ToList();
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3 pb-3 border-bottom">
    <div>
        <div class="mb-1">
            <a asp-action="Index" class="small text-muted text-decoration-none">&larr; Visos temos</a>
        </div>
        <h1 class="h3 fw-bold mb-0">@topic.Name</h1>
    </div>
    <span class="status-pill" id="countBadge">Rodoma: @topic.Exercises.Count</span>
</div>

@if (topic.Exercises.Any())
{
    <div class="vbe-card p-2 px-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <select id="yearFilter" class="form-select form-select-sm w-auto" onchange="filterEx()">
                <option value="">Visi metai</option>
                @foreach (var y in years)
                {
                    <option value="@y">@y m.</option>
                }
            </select>

            <select id="sessionFilter" class="form-select form-select-sm w-auto" onchange="filterEx()">
                <option value="">Visos sesijos</option>
                <option value="pagr">Pagrindinė</option>
                <option value="pak">Pakartotinė</option>
            </select>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <select id="statusFilter" class="form-select form-select-sm w-auto" onchange="filterEx()">
                    <option value="">Visos būsenos</option>
                    <option value="0">Nespręstos</option>
                    <option value="1">Išspręstos</option>
                    <option value="review">Atidėtos pakartoti</option>
                </select>
            }
        </div>

        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="pickRandomExercise()">Atsitiktinė</button>
    </div>

    @foreach (var ex in topic.Exercises)
    {
        Model.ProgressByExerciseId.TryGetValue(ex.Id, out var prog);
        @await Html.PartialAsync("_ExerciseCardPartial", (ex, prog, (string?)null))
    }
}

@section Scripts {
<script>
    function filterEx() {
        const y = document.getElementById('yearFilter')?.value || '';
        const s = document.getElementById('sessionFilter')?.value || '';
        const st = document.getElementById('statusFilter')?.value || '';

        let count = 0;
        document.querySelectorAll('.exercise-card').forEach(el => {
            const matchYear = !y || el.dataset.year === y;
            const matchSess = !s || el.dataset.session === s;
            const matchStatus = !st
                || (st === 'review' ? (el.dataset.status === '2' || el.dataset.status === '3') : el.dataset.status === st);

            const visible = matchYear && matchSess && matchStatus;
            el.style.display = visible ? '' : 'none';
            if (visible) count++;
        });

        document.getElementById('countBadge').textContent = `Rodoma: ${count}`;
    }

    function pickRandomExercise() {
        const visible = Array.from(document.querySelectorAll('.exercise-card')).filter(el => el.style.display !== 'none');
        if (!visible.length) return;
        const chosen = visible[Math.floor(Math.random() * visible.length)];
        chosen.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
</script>
}
