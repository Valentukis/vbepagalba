@model VbeSort.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Administravimas";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 pb-3 border-bottom">
    <h1 class="h3 fw-bold mb-0">Administravimas</h1>
    <span class="status-pill">Viso: @Model.Users.Count</span>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="vbe-card overflow-hidden">
            <div class="p-3 border-bottom">
                <h2 class="h6 fw-bold mb-0">Vartotojų sąrašas</h2>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Vardas</th>
                            <th>Rolė</th>
                            <th class="text-center">Išspręsta</th>
                            <th>Sukurta</th>
                            <th class="text-end">Veiksmai</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Users)
                        {
                            var solved = Model.SolvedByUserId.GetValueOrDefault(u.Id, 0);
                            var isSelf = u.Username.Equals(User.Identity?.Name, StringComparison.OrdinalIgnoreCase);
                            <tr>
                                <td>@u.Id</td>
                                <td><strong>@u.Username</strong></td>
                                <td>
                                    <span class="status-pill">
                                        @(u.Role == "Admin" ? "Admin" : "Mokinys")
                                    </span>
                                </td>
                                <td class="text-center">@solved</td>
                                <td class="text-muted">@u.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    @if (!isSelf)
                                    {
                                        <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Trinti vartotoją?');">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger py-0">Trinti</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Jūs</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="vbe-card p-3 mb-3">
            <h2 class="h6 fw-bold mb-2">Pridėti vartotoją</h2>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-2">
                    <label class="form-label small mb-1">Prisijungimo vardas</label>
                    <input name="Username" class="form-control form-control-sm" required minlength="3" />
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-1">Slaptažodis</label>
                    <input name="Password" type="password" class="form-control form-control-sm" required minlength="4" />
                </div>
                <div class="mb-3">
                    <label class="form-label small mb-1">Rolė</label>
                    <select name="Role" class="form-select form-select-sm">
                        <option value="Student">Mokinys</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>
                <button class="btn btn-primary btn-sm w-100">Sukurti paskyrą</button>
            </form>
        </div>

        <div class="vbe-card p-3">
            <h2 class="h6 fw-bold mb-2">Pakeisti slaptažodį</h2>
            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-2">
                    <label class="form-label small mb-1">Vartotojas</label>
                    <select name="id" class="form-select form-select-sm">
                        @foreach (var u in Model.Users)
                        {
                            <option value="@u.Id">@u.Username</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-1">Naujas slaptažodis</label>
                    <input name="newPassword" type="password" class="form-control form-control-sm" required minlength="4" />
                </div>
                <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Atstatyti slaptažodį</button>
            </form>
        </div>
    </div>
</div>
