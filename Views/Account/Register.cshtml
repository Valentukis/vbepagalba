@model VbeSort.Models.RegisterViewModel
@{
    ViewData["Title"] = "Registracija";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-6 col-lg-5">
        <div class="vbe-card overflow-hidden">
            <div class="p-3 border-bottom">
                <h1 class="h5 fw-bold mb-0">Nauja mokinio paskyra</h1>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Username" class="form-label small fw-semibold">Prisijungimo vardas *</label>
                            <input asp-for="Username" class="form-control" placeholder="pvz. jonas2027" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="DisplayName" class="form-label small fw-semibold">Rodomas vardas</label>
                            <input asp-for="DisplayName" class="form-control" placeholder="pvz. Jonas" />
                            <span asp-validation-for="DisplayName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Password" class="form-label small fw-semibold">Slaptažodis *</label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="ConfirmPassword" class="form-label small fw-semibold">Pakartokite slaptažodį *</label>
                            <input asp-for="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Sukurti paskyrą</button>
                </form>

                <div class="text-center mt-3 pt-3 border-top small">
                    Jau turite paskyrą?
                    <a asp-action="Login" class="fw-semibold text-decoration-none">Prisijungti</a>
                </div>
            </div>
        </div>
    </div>
</div>
