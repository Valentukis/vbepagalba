@model VbeSort.Models.LoginViewModel
@{
    ViewData["Title"] = "Prisijungti";
}

<div class="row justify-content-center">
    <div class="col-md-4 mt-5">
        <div class="card shadow">
            <div class="card-header bg-primary text-white text-center">
                <h4>Prisijungti</h4>
            </div>
            <div class="card-body">
                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Prisijungimo vardas</label>
                        <input asp-for="Username" class="form-control" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Slaptažodis</label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Prisijungti</button>
                </form>
            </div>
        </div>
    </div>
</div>

