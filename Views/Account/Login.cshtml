@model VbeSort.Models.LoginViewModel
@{
    ViewData["Title"] = "Prisijungti";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5 col-lg-4">
        <div class="vbe-card overflow-hidden">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="fw-bold mb-0">Prisijungti prie VBE Rūšiuoklės</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label small fw-semibold">Prisijungimo vardas</label>
                        <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold">Slaptažodis</label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small">Prisiminti mane šioje naršyklėje</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-semibold">Prisijungti</button>
                </form>

                <div class="text-center mt-3 pt-3 border-top small">
                    Neturite paskyros?
                    <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="fw-semibold text-decoration-none">Sukurti mokinio paskyrą</a>
                </div>
            </div>
        </div>
    </div>
</div>
